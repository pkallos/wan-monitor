{
  "name": "@wan-monitor/shared",
  "private": true,
  "type": "module",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./metrics": {
      "types": "./src/metrics.ts",
      "default": "./src/metrics.ts"
    },
    "./db-schema": {
      "types": "./src/db-schema.ts",
      "default": "./src/db-schema.ts"
    }
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "format:check": "biome format ."
  },
  "dependencies": {
    "effect": "4.0.0-beta.107"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.7",
    "typescript": "^7.0.2",
    "vitest": "^3.2.4"
  }
}
