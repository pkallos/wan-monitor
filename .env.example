# =============================================================================
# WAN Monitor Environment Configuration
# =============================================================================
# Copy this file to .env.local for development (see Configuration in README.md).
#
# For development:
#   cp .env.example .env.local
#   pnpm start:dev
#
# For Docker, set variables with -e flags or an environment block, as in the
# Quick Start section of README.md.
# =============================================================================

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------
SERVER_PORT=3001
SERVER_HOST=0.0.0.0

# -----------------------------------------------------------------------------
# Logging Configuration
# -----------------------------------------------------------------------------
# Log level: trace, debug, info, warn, error, fatal (default: info)
# Any case works; any other value stops the server at startup.
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Database Configuration (QuestDB)
# -----------------------------------------------------------------------------
# For development: point to a local or Docker QuestDB instance
# For production Docker: leave DB_HOST at localhost to use the embedded QuestDB
DB_HOST=localhost
DB_PORT=9000
DB_PROTOCOL=http
DB_AUTO_FLUSH_ROWS=100
DB_AUTO_FLUSH_INTERVAL=1000
DB_REQUEST_TIMEOUT=10000
DB_RETRY_TIMEOUT=1000
DB_QUERY_TIMEOUT=25000

# -----------------------------------------------------------------------------
# Monitoring Configuration
# -----------------------------------------------------------------------------
# How often to run ping tests (default: 30 seconds)
PING_INTERVAL_SECONDS=30

# Ping timeout in seconds
PING_TIMEOUT=5

# Number of ICMP packets per ping train (for packet loss measurement)
PING_TRAIN_COUNT=10

# Comma-separated list of hosts to ping
PING_HOSTS=8.8.8.8,1.1.1.1,cloudflare.com

# How often to run speed tests (default: 3600 seconds = 1 hour)
# Note: Speed tests consume bandwidth, so raise the interval on metered connections.
SPEEDTEST_INTERVAL_SECONDS=3600

# Maximum time for a speed test before timeout (default: 120 seconds)
# Increase this if you have a slow connection that takes longer to complete tests
SPEEDTEST_TIMEOUT_SECONDS=120

# -----------------------------------------------------------------------------
# Authentication Configuration
# -----------------------------------------------------------------------------
# Username for dashboard login (default: admin)
WAN_MONITOR_USERNAME=admin

# Password for dashboard login
# Set a password to enable authentication; leave it empty to disable authentication.
WAN_MONITOR_PASSWORD=

# Secret key for JWT token signing
# Set whenever WAN_MONITOR_PASSWORD is set. When empty, a random secret is
# generated at each start and sessions do not survive a restart.
# Use a random string (32+ chars recommended)
# Generate with: openssl rand -base64 32
JWT_SECRET=

# JWT token expiration time (default: 24h)
# Needs a unit: 90m, 24h, 7d. A bare number such as 3600 stops the server at startup.
JWT_EXPIRES_IN=24h
