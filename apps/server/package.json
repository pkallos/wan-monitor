{
  "name": "@wan-monitor/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "node ../../dist/server/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "VITEST_INTEGRATION=true vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "format:check": "biome format ."
  },
  "dependencies": {
    "@effect/platform-node": "4.0.6",
    "@questdb/nodejs-client": "^4.2.0",
    "effect": "4.0.6",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "ping": "^1.0.0",
    "speedtest-net": "2.2.0"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/speedtest-net": "^2.1.5",
    "@vitest/coverage-v8": "^5.0.5",
    "@wan-monitor/shared": "workspace:*",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
