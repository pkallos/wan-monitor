{
  "name": "wan-monitor",
  "version": "1.2.2",
  "private": true,
  "type": "module",
  "description": "WAN monitoring dashboard with network performance tracking",
  "author": "pkallos",
  "license": "GPL-3.0-only",
  "packageManager": "pnpm@9.6.0",
  "repository": {
    "type": "git",
    "url": "git@github.com:pkallos/wan-monitor.git"
  },
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "dev:web": "pnpm --filter @wan-monitor/web run dev",
    "dev:server": "pnpm --filter @wan-monitor/server run dev",
    "build": "pnpm -r run build",
    "build:server": "pnpm --filter @wan-monitor/server run build",
    "start:server": "node dist/server/index.js",
    "smoke:server": "tsx scripts/smoke-server.ts",
    "preview": "pnpm --filter @wan-monitor/web preview",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f questdb",
    "start:dev": "pnpm db:up && pnpm dev",
    "test": "pnpm -r run test",
    "test:coverage": "pnpm -r run test:coverage",
    "test:release": "node --test scripts/release/*.test.mjs",
    "test:integration": "pnpm --filter @wan-monitor/server test:integration",
    "test:e2e": "playwright test",
    "test:all": "pnpm --filter @wan-monitor/web test && pnpm test:integration && pnpm test:e2e",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:codegen": "playwright codegen http://localhost:3000",
    "typecheck": "pnpm -r run typecheck",
    "typecheck:e2e": "tsc -p e2e/tsconfig.json --noEmit",
    "lint": "pnpm -r run lint",
    "lint:fix": "biome check --write .",
    "format": "pnpm -r run format",
    "format:check": "pnpm -r run format:check",
    "check": "biome check --write .",
    "docker:build": "docker build -t wan-monitor:local .",
    "changeset": "changeset",
    "prepare": "husky",
    "postinstall": "sh scripts/patch-speedtest-net.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.0",
    "@effect/vitest": "4.0.0-beta.102",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.13.3",
    "@wan-monitor/shared": "workspace:*",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=8.0.0"
  },
  "pnpm": {
    "overrides": {
      "lzma-native": "npm:@favware/skip-dependency@1.2.2"
    }
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "biome check --write --assist-enabled=true",
      "biome format --write"
    ],
    "*.{json,jsonc}": [
      "biome format --write"
    ]
  }
}
